# Enter values in Dokploy Environment or copy to an ignored .env.production.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=api.example.com
DJANGO_CORS_ALLOWED_ORIGINS=https://app.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://api.example.com

# Use different random passwords for the bootstrap admin and Django role.
DB_NAME=agentix
DB_USER=agentix
DB_PASSWORD=
POSTGRES_USER=agentix_admin
POSTGRES_PASSWORD=

# Enable only providers used by the configured workflow.
GROQ_API_KEY=
GROQ_MODEL_NAME=openai/gpt-oss-120b
GOOGLE_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL_NAME=openrouter/free
TAVILY_API_KEY=

SPECIALIST_LLM_PROVIDER=groq
SPECIALIST_LLM_MODEL=
SUPERVISOR_LLM_PROVIDER=groq
SUPERVISOR_LLM_MODEL=
SUPERVISOR_FALLBACK_ENABLED=false
SUPERVISOR_FALLBACK_1_PROVIDER=gemini
SUPERVISOR_FALLBACK_1_MODEL=gemini-2.5-flash
SUPERVISOR_FALLBACK_2_PROVIDER=openrouter
SUPERVISOR_FALLBACK_2_MODEL=openrouter/free
GEMINI_FREE_TIER_CONFIRMED=false
GROQ_FREE_TIER_CONFIRMED=false

# Optional SMTP relay. Configure before enabling any email workflow.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com

GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
