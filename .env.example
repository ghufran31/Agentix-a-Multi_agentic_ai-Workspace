DJANGO_SECRET_KEY=replace-with-a-generated-django-secret-key
DB_NAME=replace-with-your-postgresql-database-name
DB_USER=replace-with-your-postgresql-username
DB_PASSWORD=replace-with-your-postgresql-password
DB_HOST=replace-with-your-postgresql-host
DB_PORT=replace-with-your-postgresql-port
# Optional. When false/0/off, stock Django Admin presentation is used.
# Model registrations remain active either way. Restart the server after changing.
AGENTIX_ADMIN_CUSTOMIZATION_ENABLED=true
GROQ_API_KEY=
TAVILY_API_KEY=
GROQ_MODEL_NAME=openai/gpt-oss-120b
GROQ_TEMPERATURE=0
GROQ_REQUEST_TIMEOUT=60
GROQ_MAX_RETRIES=2
GROQ_MAX_TOKENS=16384
OPENROUTER_API_KEY=
OPENROUTER_MODEL_NAME=
OPENROUTER_TIMEOUT_MS=30000
OPENROUTER_MAX_TOKENS=1024
SPECIALIST_LLM_PROVIDER=groq
SPECIALIST_LLM_MODEL=
SUPERVISOR_LLM_PROVIDER=groq
SUPERVISOR_LLM_MODEL=

# Internal Supervisor developer console. Enable only for authorized local staff.
AGENTIX_SUPERVISOR_CONSOLE_ENABLED=false
AGENTIX_SUPERVISOR_CONSOLE_MODE=mock
# Optional separate PostgreSQL checkpoint and console database.
# AGENTIX_CHECKPOINT_DSN=

# Gemini and Supervisor-only fallback
# Confirm a free-tier project before enabling automatic Gemini fallback.
GOOGLE_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash
GEMINI_REQUEST_TIMEOUT=30
GEMINI_FREE_TIER_CONFIRMED=false
GROQ_FREE_TIER_CONFIRMED=false
SUPERVISOR_FALLBACK_ENABLED=true
SUPERVISOR_FALLBACK_1_PROVIDER=gemini
SUPERVISOR_FALLBACK_1_MODEL=gemini-2.5-flash
SUPERVISOR_FALLBACK_2_PROVIDER=openrouter
SUPERVISOR_FALLBACK_2_MODEL=openrouter/free

# Enable approval-gated real console writes only against test_Agentix.
AGENTIX_SUPERVISOR_CONSOLE_TEST_WRITES=false
